{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stellar-agent.dev/schemas/cli/policy-explain.schema.json",
  "title": "stellar-agent policy explain --json data",
  "type": "object",
  "required": ["status", "matchedRules", "reasons", "spendHistory"],
  "additionalProperties": true,
  "properties": {
    "status": { "enum": ["allowed", "denied", "requires_approval"] },
    "matchedRules": { "type": "array", "items": { "type": "string" } },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "spendHistory": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "dailyTotal": { "type": "string" },
        "monthlyTotal": { "type": "string" },
        "knownRecipients": { "type": "array", "items": { "type": "string" } },
        "knownDomains": { "type": "array", "items": { "type": "string" } },
        "receiptCount": { "type": "integer", "minimum": 0 },
        "unreadableCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
